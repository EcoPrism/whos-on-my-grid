# Copy to services/api/.env and fill in. The .env file is gitignored.

# Which backend produces the brief: fixtures | agent | full
#   agent: Muse Spark drafts from its own knowledge (the 'before' picture).
#   full:  facilities (PeeringDB + OpenStreetMap), serving utility (HIFLD), prices
#          (EIA-861M, EIA-861) and the tariff table (data/regions/us/tariffs.json) are the
#          engine's; Spark writes the sentences. No extra keys; data cached under data/ground.
GRID_BRIEF_SOURCE=fixtures
# openai | fake. fake is scripted and needs no network; agent mode needs openai.
GRID_LLM_PROVIDER=fake

# Drafting: Muse Spark 1.3 through the Betahub LLM Gateway (LiteLLM proxy).
# The key is this project's gateway virtual key, never a raw provider key.
# The model is a gateway alias; repointing it is a gateway change, not a release.
GRID_OPENAI_API_KEY=
GRID_OPENAI_BASE_URL=https://llmgw-app.politehill-63ad311b.westeurope.azurecontainerapps.io/v1
GRID_DRAFT_MODEL=meta-flagship

# Verifying: Muse Spark Open directly on Baseten (OpenAI-compatible endpoint).
GRID_BASETEN_API_KEY=                   # optional: leave empty and claims stay unchecked
GRID_BASETEN_BASE_URL=https://inference.baseten.co/v1
GRID_VERIFY_MODEL=meta-models/muse-spark-open
# The Baseten x Meta hackathon key serves only the newer build: with that key set
# GRID_VERIFY_MODEL=meta-models/muse-spark-open-1026 (check the key's /v1/models).
# Set false if the endpoint rejects response_format=json_schema; the prompt then carries the schema.
GRID_VERIFY_STRICT_JSON=true

# Step 4 indexers only (never on the request path): SAM 3.1 and Muse Voice Transcribe on the
# Meta Model API, direct. Create the key at dev.meta.ai. The API reads the indexers' output
# from data/regions/us/perception and data/regions/us/hearings, which are committed.
GRID_META_API_KEY=
GRID_META_BASE_URL=https://api.meta.ai/v1
GRID_SAM_MODEL=sam-3.1
GRID_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# The defaults are the US region's directories; set these only to point elsewhere.
# GRID_PERCEPTION_DIR=data/regions/us/perception
# GRID_HEARINGS_DIR=data/regions/us/hearings

# Tuning (defaults shown)
GRID_LLM_MAX_TOKENS=6144
GRID_LLM_TIMEOUT_SECONDS=180
GRID_VERIFY_MAX_TOKENS=1024
GRID_VERIFY_TIMEOUT_SECONDS=60
GRID_VERIFY_CONCURRENCY=8
GRID_FETCH_TIMEOUT_SECONDS=10
# Brief cache, relative to the repo root. Gitignored. Holds briefs keyed by hash, never addresses.
GRID_DATA_DIR=data/briefs
GRID_CORS_ORIGINS=http://localhost:5173,http://localhost:5180
# Country gate for /api/brief. Leave empty locally. Set GRID_ALLOWED_COUNTRIES=US only behind an
# edge that writes the visitor country into GRID_COUNTRY_HEADER (Cloudflare: cf-ipcountry).
# With Ireland on (GRID_REGIONS=us,ie) it must list US,IE, or Irish visitors get 403.
GRID_ALLOWED_COUNTRIES=
GRID_COUNTRY_HEADER=cf-ipcountry

# Regions this process serves: us, or us,ie to add Ireland on the same image.
GRID_REGIONS=us
GRID_DEFAULT_REGION=us
# Ireland's geocoder: nominatim | fake (fake answers only eval/ie/addresses.json, for
# fixtures mode). The public OSMF Nominatim allows 1 request a second from one machine:
# fine for dev and eval, not for production; point GRID_NOMINATIM_URL at a hosted one.
GRID_IE_GEOCODER=nominatim
GRID_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Sent as `email` with each Nominatim request, as the OSMF usage policy asks. Optional.
GRID_NOMINATIM_EMAIL=
GRID_NOMINATIM_MIN_INTERVAL_SECONDS=1.0
# Days an Irish (non-US) brief is kept; 0 keeps it until the engine changes. The US
# always keeps. The sweep that deletes old briefs and their cards runs this often.
GRID_BRIEF_TTL_DAYS=0
GRID_BRIEF_SWEEP_HOURS=6

# Sign-in gate for NEW briefs only: viewing a brief, and running a test-set address
# (eval/<region>/addresses.json), never needs sign-in. off = anyone can generate (local dev).
# google = Google Identity Services; the client id is public, the session secret is not.
# fake = "fake:<sub>:<email>" tokens, tests only.
GRID_AUTH_PROVIDER=off
GRID_GOOGLE_CLIENT_ID=
GRID_SESSION_SECRET=                    # 32+ random characters; required unless off
GRID_COOKIE_SECURE=true                 # false for http://localhost
# Where sign-ins and generated briefs are recorded: memory | table (Azure Table Storage,
# reached with the managed identity). Rows hold email and brief id, never an address.
GRID_USAGE_STORE=memory
GRID_STORAGE_ACCOUNT=
GRID_QUOTA_PER_USER_DAY=5
GRID_QUOTA_GLOBAL_DAY=40
# The built web app (web/dist). Served by the API when the directory exists; in the
# container it always does, locally Vite serves the page instead.
GRID_WEB_DIST=web/dist
