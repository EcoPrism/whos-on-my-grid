    "facilities": "[min, max|null] total facilities (live + under_construction + announced) within five miles",
    "live": "[min, max|null] live facilities, when the split matters",
    "announced_min": "at least this many announced/under-construction when the split matters",
    "operators": "operator names (case-insensitive substrings) a correct brief names; `operators_min` of them must appear",
    "utility": "regex the serving utility must match (address.utility or any section text)",
    "bill": "{direction: up|flat|any, range: [lo, hi] dollars/month for the hero number, attribution: null|required|any}",
    "protection": "acceptable large_load_tariff values; `protection_specific` requires a tariff name or docket",
    "strip_requires": "topics that must appear among the at-your-house lines (positive controls)",
    "strip_lead": "topic the first model-written strip line must have",
    "forbid": "regexes that must not match anywhere in the brief text (hard fails)",
    "require_text": "regexes that must match somewhere in the brief text",
    "hearing": "expected | none_ok  (informational: a real hook cannot be checked automatically)"
  },
