    "facilities": "[min, max|null] distinct facilities within 8 km",
    "operators": "names expected in the facility list (case-insensitive substrings); `operators_min` of them must appear",
    "utility": "regex the serving network operator must match (address.utility or any section text)",
    "bill": "{direction: up|flat|any, range: [lo, hi] EUR a month for the headline figure (`ai_rent_usd_per_month` keeps its legacy key; the brief's currency is locale.currency), attribution: null|required|any}",
    "protection": "acceptable large_load_tariff values",
    "forbid": "regexes that must not match anywhere in the brief text (hard fails)",
    "require_text_any": "at least one of these regexes must match somewhere in the brief text",
    "hearing": "expected | none_ok  (informational: a real hook cannot be checked automatically)",
    "geocode": "what the fake geocoder returns for this row (stream A loads it; lat/lon snapped to 3 decimals; matched equals display, no house numbers anywhere)"
  },
